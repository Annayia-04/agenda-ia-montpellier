# Copier ce fichier en .env ou exporter ces variables dans l'environnement.

# HTTP
PORT=4500
HOST=127.0.0.1

# Données
# Par défaut : agenda/data/events.json (résolu depuis le dossier de l'application).
# AGENDA_DATA_DIR=/chemin/vers/agenda/data
# demo = quelques évènements fictifs au premier lancement, empty = agenda vide
AGENDA_SEED=demo

# Modération : définir un jeton long et aléatoire en production.
# S'il est absent, un jeton est généré au démarrage et affiché dans la console.
AGENDA_ADMIN_TOKEN=

# Nombre d'échecs de jeton avant blocage temporaire de l'IP.
AGENDA_ADMIN_RATE_LIMIT=10

# URL publique (liens de partage, flux .ics) et domaines autorisés à intégrer l'iframe.
AGENDA_PUBLIC_URL=
AGENDA_EMBED_ORIGINS=*
AGENDA_CORS_ORIGIN=*

# À mettre à 1 uniquement derrière un proxy de confiance (nginx, Cloudflare…),
# pour que X-Forwarded-For soit utilisé dans les limites de débit.
AGENDA_TRUST_PROXY=0

# Fuseau utilisé pour convertir les heures dans les fichiers .ics.
AGENDA_TZ=Europe/Paris

# Anti-spam : 8 propositions par IP toutes les 10 minutes.
AGENDA_RATE_LIMIT=8
AGENDA_RATE_WINDOW_MS=600000
